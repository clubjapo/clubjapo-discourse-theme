{{! Botón "Responder" para el indicador de progreso móvil (#topic-progress-wrapper). }}
{{! El click se engancha aparte, en javascripts/discourse/api-initializers/ }}
{{! clubjapo-quick-reply-click.js -- un atributo onclick="" en línea aquí NO }}
{{! funciona: la CSP del sitio (script-src con nonce + strict-dynamic, sin }}
{{! 'unsafe-inline') bloquea los manejadores de eventos en línea sin avisar }}
{{! por consola; el atributo queda en el DOM pero el navegador nunca lo activa. }}
<button type="button" class="btn clubjapo-mobile-quick-reply" title="Responder">
  <svg class="fa d-icon d-icon-reply svg-icon" width="1em" height="1em" xmlns="http://www.w3.org/2000/svg"><use href="#reply"></use></svg>
  <span>Responder</span>
</button>
